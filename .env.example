# Puerto HTTP del servidor (3000 en AI Studio, 8080 en Docker/local si se desea)
PORT=3000
NODE_ENV=development

# Base de datos PostgreSQL.
# Si se deja vacío en desarrollo local, se usa PostgreSQL embebido (PGlite) en ./data/pgdata
DATABASE_URL=
PGLITE_DATA_DIR=./data/pgdata

# Secretos JWT (en producción usar claves aleatorias de al menos 64 caracteres)
JWT_ACCESS_SECRET=cambia-este-secreto-access-en-produccion-min-32-chars
JWT_REFRESH_SECRET=cambia-este-secreto-refresh-en-produccion-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# Seguridad y Hashing
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Operación del lavadero (America/Bogota)
SHOP_OPEN_HOUR=8
SHOP_CLOSE_HOUR=18
SHOP_PARALLEL_BAYS=2
SHOP_SLOT_STEP_MINUTES=30
SHOP_OPEN_SUNDAY=false
CANCELLATION_PENALTY_COP=1000
CANCELLATION_MIN_HOURS=3
EXPIRATION_CHECK_INTERVAL_MS=30000
LOYALTY_REWARD_VALID_DAYS=30
LOYALTY_MAX_MANUAL_VALID_DAYS=180
LOYALTY_QR_TTL_MINUTES=1440

# Firebase Cloud Messaging (opcional; si se omite se usa notificación in-app + polling)
FIREBASE_SERVICE_ACCOUNT_JSON=
